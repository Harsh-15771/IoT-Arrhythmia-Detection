# ============================================================
# CardioTwin - Environment Configuration
# Copy this file to .env and configure for local deployment
# ============================================================

# Backend API & WebSocket Port
PORT=5000
HOST=0.0.0.0
FLASK_ENV=development
SECRET_KEY=cardiotwin_research_secret_2026

# Digital Twin Parameters
TARGET_FS=100
WINDOW_SEC=10
DEFAULT_PATIENT_ID=PAT001
SOUTH_ASIAN_RECALIBRATION_FACTOR=1.45

# Hardware Ingestion Configuration
# Replace with the local IP address of your workstation on the WiFi network
SERVER_HOST_IP=192.168.1.100

ESP32_CHUNK_SIZE=50
SQI_GATING_THRESHOLD=0.40

# Logging & Storage
ENABLE_CSV_LOGGING=true
RECORDINGS_DIR=./recordings
